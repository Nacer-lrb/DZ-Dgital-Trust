{
  "name": "dz-sign-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app tests next.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check app tests next.config.ts tsconfig.json package.json .prettierrc.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
